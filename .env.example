# เล่าไว้ — ตัวอย่าง environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# ⚠️ .env.local ถูก gitignore ไว้แล้ว ห้าม commit ค่าจริงลง repo เด็ดขาด
#
# นิคเป็นคนสร้างค่าพวกนี้ แล้วส่ง .env.local ให้ศิลปทางไลน์ (ไม่ใช่ทาง git)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini → https://aistudio.google.com/apikey
# อยู่ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
GEMINI_API_KEY=

# URL สาธารณะของเว็บ — ใช้สร้าง QR ที่อยู่ในหนังสือ
# ตอน dev ใส่ http://localhost:3000
# ตอน deploy ใส่ https://laowai-th.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
